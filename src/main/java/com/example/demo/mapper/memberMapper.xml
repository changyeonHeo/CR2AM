<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
 PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.mapper.memberMapper">

   <select id="checkMember" parameterType="java.util.Map"
      resultType="memberDTO">
      select * from member2 where hp1=#{hp1} and hp2=#{hp2} and hp3=#{hp3}
   </select>

   <insert id="insertMember" parameterType="memberDTO">
      insert into member2 values
      (mem_seq.nextval,#{id},#{name},#{passwd},#{hp1},#{hp2},#{hp3}
      ,#{gender},sysdate,0,#{email},NULL)
   </insert>

   <delete id="deleteMember" parameterType="int">
      delete from member2 where mem =#{mem}
   </delete>

   <!-- <select id="listMember" resultType="memberDTO"> select * from member2 
      </select> -->

   <select id="listMember" parameterType="java.util.Map"
      resultType="memberDTO">
      select * from (select rownum rn, A.* from
      (select * from member2)A)
      where rn between #{start} and #{end}
   </select>

   <select id="findMember" parameterType="String"
      resultType="memberDTO">
      select * from member2 where id = #{id}
   </select>

   <select id="findMember1" parameterType="String"
      resultType="memberDTO">
      select * from member2 where ${search} like #{searchString}
   </select>

   <update id="updateMember" parameterType="memberDTO">
      update member2 set passwd=#{passwd}, hp1=#{hp1}, hp2=#{hp2}, hp3=#{hp3}
      where id = #{id}
   </update>
   
   <select id="searchMember" resultType="memberDTO"
      parameterType="java.util.Map">
      select * from member2 where name=#{name} and hp1=#{hp1} and hp2=#{hp2}
      and hp3=#{hp3}
      <if test="id != null"> and id = #{id} </if>
   </select>

   <select id="getCount" resultType="int">
      select count(*) from member2
   </select>
   
   <select id="getidCount" parameterType="String" resultType="int">
      select count(*) from member2 where id = #{id}
   </select>
   
   <select id="getMem" parameterType="String" resultType="int">
      select mem from member2 where id = #{id}
   </select>
   
   <update id="updateProimg" parameterType="memberDTO">
      update member2 set proimg=#{proimg}
      where id = #{id}
   </update>

</mapper>